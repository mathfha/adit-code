{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/build/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/favicon.(ico|png|svg)",
      "dest": "/favicon.$1"
    },
    {
      "src": "/apple-touch-icon.png",
      "dest": "/apple-touch-icon.png"
    },
    {
      "src": "/og.png",
      "dest": "/og.png"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "cookie",
    "CACHE_STORE": "array",
    "APP_STORAGE": "/tmp/storage",
    "APP_SERVICES_CACHE": "/tmp/storage/cache/services.php",
    "APP_PACKAGES_CACHE": "/tmp/storage/cache/packages.php",
    "APP_CONFIG_CACHE": "/tmp/storage/cache/config.php",
    "APP_ROUTES_CACHE": "/tmp/storage/cache/routes.php",
    "APP_EVENTS_CACHE": "/tmp/storage/cache/events.php",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views"
  }
}
